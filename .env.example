# Public client config (exposed to the browser via Vite).
# Copy to `.env` and fill in your values.
# Never put real private API secrets in VITE_* variables.

# Author display name in Settings
VITE_AUTHOR_NAME=Your Name

# X / Twitter profile URL (Settings one-tap button + share card)
VITE_X_URL=https://x.com/your_handle

# Optional display handle (without @). Falls back to parsing VITE_X_URL.
VITE_X_HANDLE=your_handle
